# development | test | production. Governs a small number of explicit
# production-only checks at boot (rejecting insecure defaults, warning about
# missing SMTP/non-HTTPS origin — see src/main.ts and src/config/env.validation.ts)
# and the refresh-token cookie's `Secure` flag. Defaults to "development".
NODE_ENV="development"

DATABASE_URL="postgresql://forge:forge@localhost:5432/forge?schema=public"
API_PORT="3000"
WEB_ORIGIN="http://localhost:5173"

# Used by Fellowship Chat for cross-instance WebSocket event fan-out — see
# docs/adr/0014-fellowship-chat.md Decision 2. Optional infrastructure: the
# API degrades gracefully (REST chat read/write keeps working; only
# real-time delivery is affected) if Redis is unreachable, so it is
# deliberately not part of GET /health/ready.
REDIS_URL="redis://localhost:6379"

# Auth — generate real, random secrets for every real environment (dev
# included); never commit real values. The literal placeholder values below
# are rejected at boot (see env.validation.ts) — they exist only to show the
# expected shape.
JWT_ACCESS_SECRET="replace-with-a-random-32-byte-minimum-secret"
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="2592000"

ARGON2_MEMORY_COST="19456"
ARGON2_TIME_COST="2"
ARGON2_PARALLELISM="1"

# 32-byte key, hex-encoded (64 hex characters), used to encrypt TOTP secrets at rest.
MFA_ENCRYPTION_KEY="replace-with-64-hex-characters"

PASSWORD_RESET_TOKEN_TTL_MINUTES="60"
EMAIL_VERIFICATION_TOKEN_TTL_HOURS="48"

COOKIE_SECRET="replace-with-a-random-32-byte-minimum-secret"

# Email — all optional. Leave unset to keep the dev-mode console stub (logs
# instead of sending); set all of these to switch to real SMTP delivery. See
# docs/adr/0009-administration-platform.md's 2026-09-06 email addendum.
# SMTP_HOST="smtp.your-provider.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="apikey-or-username"
# SMTP_PASSWORD="replace-with-your-real-credential"
# SMTP_FROM="Project Forge <noreply@yourdomain.com>"

# Seed script (bootstrap platform super-admin) — see prisma/seeds/identity.seed.ts.
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ORGANIZATION_NAME="Tech Impact Fellowship"
SEED_ORGANIZATION_SLUG="tech-impact-fellowship"
